# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF formatting for codebase files
*.lean text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.cff text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
.gitignore text eol=lf
lean-toolchain text eol=lf
